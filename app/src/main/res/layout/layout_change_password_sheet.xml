<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password 🔑"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Update your account password securely"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Current Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Current Password"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCurrentPasswordSheet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_card_rounded"
        android:hint="Enter current password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <!-- New Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="New Password"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewPasswordSheet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_card_rounded"
        android:hint="Enter new password (Min 8 chars)"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <!-- Confirm New Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Confirm New Password"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etConfirmNewPasswordSheet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_card_rounded"
        android:hint="Re-enter new password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnUpdatePasswordSheet"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2563EB"
        android:text="Update Password 🔑"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="25dp" />

</LinearLayout>
